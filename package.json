{
  "name": "pi-hive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hive's colony orchestration on top of the pi-agent kernel",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/cli.js serve",
    "chat": "node src/cli.js chat",
    "test": "node --test tests/*.test.js tests/compat/*.test.js",
    "smoke": "node tests/smoke-queen.js",
    "probe": "node scripts/probe-model.mjs",
    "ui:install": "npm --prefix frontend install --no-audit --no-fund",
    "ui:build": "npm --prefix frontend run build",
    "ui:test": "npm --prefix frontend test",
    "ui:dev": "npm --prefix frontend run dev",
    "qa:coverage": "node program/qa/route-coverage.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "typebox": "1.3.27"
  }
}
